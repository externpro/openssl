[submodule "boringssl"]
	path = boringssl
	url = https://boringssl.googlesource.com/boringssl

[submodule "pyca.cryptography"]
	path = pyca-cryptography
	url = https://github.com/pyca/cryptography.git

[submodule "krb5"]
	path = krb5
	url = https://github.com/krb5/krb5
[submodule ".devcontainer"]
	path = .devcontainer
	url = https://github.com/externpro/externpro
[submodule "asmfromnode"]
	path = asmfromnode
	url = https://github.com/externpro/opensslasm
